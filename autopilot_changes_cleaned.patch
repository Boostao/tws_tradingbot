+package main
+
+import (
+	"fmt"
+	"log"
+	"tws_traderbot/backend/bot"
+	"tws_traderbot/backend/db"
+	"tws_traderbot/backend/models"
+	_ "tws_traderbot/backend/strategy"
+)
+
+type MockEmitter struct{}
+
+func (e *MockEmitter) Emit(name string, data any) {
+	fmt.Printf("Event: %s, Data: %+v\n", name, data)
+}
+
+func main() {
+	database, err := db.Connect("tws_traderbot.sqlite")
+	if err != nil {
+		log.Fatalf("Database connection failed: %v", err)
+	}
+
+	engine := bot.NewEngine()
+	engine.AttachDB(database)
+	engine.AttachEmitter(&MockEmitter{})
+	engine.SetGlobalEnabled(true)
+
+	// Example scenario
+	fmt.Println("Running autopilot...")
+	var strat *models.Strategy
+	strat, err = database.LoadStrategyPreset("default")
+	if err != nil {
+		log.Fatalf("Failed to load strategy: %v", err)
+	}
+
+	err = engine.StartBot(strat)
+	if err != nil {
+		log.Fatalf("Failed to start engine: %v", err)
+	}
+
+	fmt.Println("Engine started.")
+}
