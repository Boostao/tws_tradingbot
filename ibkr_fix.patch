+// processPacingQueue handles paced retries for historical data requests.
+func (w *IBWrapper) processPacingQueue() {
+	for req := range w.pacingQueue {
+		time.Sleep(2 * time.Second) // Pacing: 0.5 req/s to be safe
+		if w.client != nil && w.connected.Load() {
+			w.client.ReqHistoricalData(req.ReqID, req.Contract, req.EndDateTime, req.Duration, req.BarSize, req.WhatToShow, req.UseRTH, req.FormatDate, req.KeepUpToDate, req.ChartOptions)
+		}
+	}
